{
  "name": "arcovia",
  "version": "0.2.2",
  "description": "Architecture intelligence CLI for React and Next.js applications.",
  "author": {
    "name": "Ghazi Khan",
    "url": "https://ghazikhan.in"
  },
  "type": "module",
  "bin": {
    "arcovia": "dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkhan205/arcovia.git"
  },
  "keywords": [
    "react",
    "nextjs",
    "architecture",
    "analysis",
    "cli",
    "typescript",
    "dependency-graph"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "pnpm clean && tsup && pnpm run build:report",
    "build:report": "node ./scripts/build-report-app.mjs",
    "test": "pnpm run build:report && vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "analyze": "node ./dist/cli.js analyze",
    "clean": "node ./scripts/clean.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "pack": "npm pack",
    "release:check": "pnpm verify && npm pack --dry-run"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "commander": "^14.0.0",
    "lucide-react": "^1.25.0",
    "ora": "^9.0.0",
    "picocolors": "^1.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "typescript": "^5.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "simple-git-hooks": "^2.11.1",
    "tsup": "^8.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.0"
  }
}
